{
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/",
      "destination": "https://teckamenagement.fr",
      "permanent": false
    },
    {
      "source": "/apercu-resultat",
      "destination": "/resultat-budget-valide/",
      "permanent": false
    },
    {
      "source": "/apercu-resultat/",
      "destination": "/resultat-budget-valide/",
      "permanent": false
    },
    {
      "source": "/apercu-resultat/:chemin+",
      "destination": "/resultat-budget-valide/:chemin+",
      "permanent": false
    },
    {
      "source": "/apercu-moins-15k",
      "destination": "/resultat-budget-non-valide/",
      "permanent": false
    },
    {
      "source": "/apercu-moins-15k/",
      "destination": "/resultat-budget-non-valide/",
      "permanent": false
    },
    {
      "source": "/apercu-moins-15k/:chemin+",
      "destination": "/resultat-budget-non-valide/:chemin+",
      "permanent": false
    },
    {
      "source": "/apercu-resultat/:chemin+/",
      "destination": "/resultat-budget-valide/:chemin+/",
      "permanent": false
    },
    {
      "source": "/apercu-moins-15k/:chemin+/",
      "destination": "/resultat-budget-non-valide/:chemin+/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/guide-budget/",
      "destination": "/guide-budget/comprendre-le-budget-d-une-pergola-sur-mesure.pdf"
    },
    {
      "source": "/visuels-3d/",
      "destination": "/visuels-3d/visuels-3d-teck-amenagement.zip"
    },
    {
      "source": "/brochure/",
      "destination": "/brochure/brochure-teck-amenagement-collection-2026-2027.pdf"
    },
    {
      "source": "/ma-fiche/:jeton",
      "destination": "https://teck-quiz-demo.vercel.app/simulez-votre-projet/fiche/:jeton"
    },
    {
      "source": "/ma-fiche/:jeton/",
      "destination": "https://teck-quiz-demo.vercel.app/simulez-votre-projet/fiche/:jeton"
    },
    {
      "source": "/simulez-votre-projet/",
      "destination": "https://teck-quiz-demo.vercel.app/simulez-votre-projet/"
    },
    {
      "source": "/simulez-votre-projet/:chemin(.*)",
      "destination": "https://teck-quiz-demo.vercel.app/simulez-votre-projet/:chemin"
    }
  ],
  "headers": [
    {
      "source": "/brochure/(.*)",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"Brochure Teck Amenagement - Collection 2026-2027.pdf\""
        },
        {
          "key": "Content-Type",
          "value": "application/pdf"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, must-revalidate"
        }
      ]
    },
    {
      "source": "/visuels-3d/(.*)",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"Visuels 3D - Teck Amenagement.zip\""
        },
        {
          "key": "Content-Type",
          "value": "application/zip"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, must-revalidate"
        }
      ]
    },
    {
      "source": "/guide-budget/(.*)",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"Comprendre le budget d'une pergola sur mesure - Teck Amenagement.pdf\""
        },
        {
          "key": "Content-Type",
          "value": "application/pdf"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, must-revalidate"
        }
      ]
    }
  ]
}
